
{% extends "base.twig" %}

{% block content %}
 <div class="layer layer--books"> 


   <div class="layer__content">
     <div class="layer__title">
       
       <h2>{{generalcontent.words.books}}</h2>
     </div>
     <div class="layer__intro">       
       <h4>
         {{generalcontent.sentences.book_intro}}
       </h4>

     </div>


     <div class="editions">
       {% for post in posts %}


          
         <div class="item {% if post.get_field('new') %}item--new{% endif %}">
           <a href="{{post.path}}">
             {% if post.thumbnail %}

             <div class="image">
               <img loading="lazy" src="{{post.thumbnail | resize(800)}}" alt="{{post.thumbnail.alt}}"
               style="width:100%;height:100%;">
             </div>
             {% endif %}
             <div class="text">
               {% set title = post.meta("pub_info") %}
               
               {% if title.number %}
               <div class="number">
                 <div>{{title.number}}</div>
               </div>
               {% endif %}
               <div class="info">
                 
                   
                 <div class="title">
                   
                   <p>{{title.subject ? title.subject : post.title}}</p>              
                 </div>
                 <div class="year">
                   <span>{{post.date("Y")}}</span>
                 </div>
                 {% if post.contributors %}
                 <div class="with">
                   {# option with limits as long as the names are , seperated
                   <span>{{post.contributors|split(",")|slice(0, 3)|join(",")}}</span>
                   } #}
                   <span>{{post.contributors}}</span>
                 </div>    
                 {% endif %}

               </div>
             </div>
           </a>
         </div>  


       {% endfor %}
     </div>



   </div>
     


 </div>
{% endblock %}
