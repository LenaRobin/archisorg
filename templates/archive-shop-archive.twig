{% block content %}
  <div class="layer layer--shop"> 
    {% include "shop_nav.twig" with {"shop_class": "layer__top--small"} %}


    <div class="layer__content">
      <div class="layer__title">
        <h2>{{generalcontent.words.publications}}</h2>
      </div>
      <div class="layer__intro">
        <h6>
          {{generalcontent.sentences.publication_intro}}
        </h6>
        {% include "block/subscribe.twig" %}
      </div>
      
{#       
      
{% extends "base.twig" %} #}

{# {% block outside_content %} #}
	<div class="content__archis">

		<div class="archis__shop">
			<div class="title">
				<h2>
                    <h2>{{generalcontent.words.publications}}</h2>
				</h2>
			</div>
			<div class="introduction">
				<h4>
                   {{generalcontent.sentences.publication_intro}}
				</h4>
			</div>
			
        	<div class="description">
				{{ page.content }}
			</div>
            
            <div class="editions">
                {% for post in shopitems %}     
                        
                        <div class="item {% if post.new %}item--new{% endif %}">
                            <a href="{{post.shop_url}}">

                            {% if post.thumbnail %}
                            <div class="image">
                                <img loading="lazy" src="{{post.thumbnail | resize(800)}}" alt="{{post.thumbnail.alt}}">
                            </div>
                            {% endif %}
                
                            <div class="text">
                                {% set title = post.meta("pub_info") %}
                                {% if title.number %}
                                <div class="number">
                                    <div>{{title.number}}</div>
                                </div>
                                {% endif %}
                                <div class="info">
                                    <div class="title">
                                        <p>{{title.subject ? title.subject : post.title}}</p>              
                                    </div>
                                    <div class="year">
                                        <span>{{post.date("Y")}}</span>
                                    </div>
                                {% if post.contributors %}
                                <div class="with">
                                {# option with limits as long as the names are , seperated
                                <span>{{post.contributors|split(",")|slice(0, 3)|join(",")}}</span>
                                } #}
                                    <span>{{post.contributors}}</span>
                                </div>    
                                {% endif %}

                            </div>
                        </div>
                    </a>
                </div>  
                {% endfor %}
            </div>



		</div>

	</div>
{% endblock %}