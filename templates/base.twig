{% block html_head_container %}

{% include 'html-header.twig' %}
	{% block head %}
	{% endblock %}
	</head>
{% endblock %}

	<body class="{{body_class}}" data-template="base.twig">
		<!-- Background layer (Archis) -->
		<div class="page {{page_class}}">
			<div class="background">
				<div class="layer__archis {{archis_class | default("layer__nav")}} layer__archis--full">
					<div class="layer__archis__top">
					
						<div class="navigation">
							<a href="/"><div class="menu__logo">Archis</div></a>

							{% include "menu.twig" with {'items': menu.get_items} %}		

							{# <div class="searchbar">
								<form action="/" class="search-bar">
									<input placeholder="Topic, issue..." type="s" name="s" pattern=".*\S.*" required>
									<button class="search-btn" type="submit">
										<span>{{generalcontent.words.search}}</span>
									</button>
								</form>
							</div> #}

							
						</div>

						<div class="navigation__secondary">
							{% include "menu-secondary.twig" with {'items': menu.get_items} %}				
						</div>
					</div>	
					<div class="layer__archis__payoff">
					
    				</div>
				</div>
			</div>
			{% block outside_content %}

			{% endblock %}
			
			{% if enable_layers %}
			<div class="{{ layers_class | default("layers")}}">
				{% block content %}

				{% endblock %}
			</div>
			{% endif %}
			

			

			
		</div>

		{# Mobile nav #}
		<div class="mobilenav__trigger">
			<svg width="41" height="20" viewBox="0 0 41 20" fill="none" xmlns="http://www.w3.org/2000/svg">
			<line y1="1" x2="41" y2="1" stroke="white" stroke-width="2"/>
			<line y1="9.59668" x2="41" y2="9.59668" stroke="white" stroke-width="2"/>
			<line y1="18.1936" x2="41" y2="18.1936" stroke="white" stroke-width="2"/>
			</svg>
		</div>


		{# Snipcart cart menu #}
		<div class="header__checkout snipcart-checkout">
			{# <span class="snipcart-total-price">$0.00</span> #}
			<div class="cart__icon">
				<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" alt="" title="" class="snipcart-cart-header__icon snipcart__icon"><path fill-rule="evenodd" clip-rule="evenodd" d="M51.714 20.47L55 60H9l3.286-39.53h9.857v-6.588C22.143 8.424 26.556 4 32 4c5.444 0 9.857 4.424 9.857 9.882v6.589h9.857zM25.43 13.883v16.47h-3.286v-6.587h-6.834l-2.737 32.94h38.856l-2.737-32.94h-6.834v6.588h-3.286v-16.47c0-3.634-2.947-6.589-6.571-6.589-3.624 0-6.571 2.955-6.571 6.588zm3.285 9.883V20.47h6.572v3.294h-6.572z" fill="currentColor"></path></svg>
				<div class="cart__count">
					<span class="snipcart-items-count">0</span>
				</div>			
			</div>
		</div>


		{% block footer %}
			{% include "footer.twig" %}
			{{ function('wp_footer') }}

		{% endblock %}	

		{# Snipcart #}
		<script async src="https://cdn.snipcart.com/themes/v3.2.1/default/snipcart.js"></script>
		<div hidden id="snipcart" data-api-key="NGYxN2ViYWMtNTk4OC00ODdiLTg5OGMtYmI1ZDg5ZTA4NzVkNjM3Njk4OTk4MzI5MjA0ODQ5" data-currency="eur">
			<billing section="bottom">
				<fieldset class="snipcart-form__set">
					<div class="snipcat-form__field-checkbox">
						<snipcart-checkbox name="acceptGDPR" required></snipcart-checkbox>
						<snipcart-label class="snipcart__font--tiny snipcart-form__label--checkbox" for="acceptGDPR">
							I have read and agree to the&nbsp<a href="https://archis.org/privacy-policy/" style="text-decoration: underline;">Privacy Policy</a>&nbspand the&nbsp<a href="https://archis.org/terms-and-conditions/" style="text-decoration: underline;">Terms and Conditions</a>
						</snipcart-label>
					</div>
				</fieldset>
			</billing>

			<featured-payment-methods>
				<div class="snipcart-featured-payment-methods">
				  <h3 class="snipcart__font--secondary snipcart__font--bold  snipcart-featured-payment-methods__title">
						<a :href="securedByUrl" class="snipcart-featured-payment-methods__link" target="_blank" style="align-items: self-end;" rel="nofollow noopener">
							<icon name="lock" class="snipcart-featured-payment-methods__title-icon"></icon>
							Secured transaction
						</a>
					</h3>

					<ul class="snipcart-featured-payment-methods__list">
						<li class="snipcart-featured-payment-methods__list-item">
							<icon name="visa" alt="Visa" class="snipcart__icon--brand"></icon>
						</li>
						<li class="snipcart-featured-payment-methods__list-item">
							<icon name="mastercard" alt="Mastercard" class="snipcart__icon--brand"></icon>
						</li>
						<li class="snipcart-featured-payment-methods__list-item">
							<icon name="method-ideal" alt="Ideal" class="snipcart__icon--brand"></icon>
						</li>
						{# <li class="snipcart-featured-payment-methods__list-item" style="width: 32px; height: 32px; margin-right: 15px;">
							<icon name="method-apple_pay" alt="Apple Pay" class="snipcart__icon--brand"></icon>
						</li> #}
						{# <li class="snipcart-featured-payment-methods__list-item">
							<icon name="method-klarna_pay_later" alt="Klarna" class="snipcart__icon--brand"></icon>
